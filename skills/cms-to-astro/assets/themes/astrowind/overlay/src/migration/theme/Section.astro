---
/**
 * A section frame with AstroWind's WidgetWrapper container and spacing, but without its `not-prose`
 * (and without its fade), so the theme's prose styles reach the content: for the text and map blocks.
 */
import Headline from '~/components/ui/Headline.astro';
import { esc } from './aw';

interface Props {
  heading?: string;
  /** Container width class (default max-w-4xl, the width of AstroWind's Markdown pages). */
  width?: string;
}

const { heading, width = 'max-w-4xl' } = Astro.props;
---

<section class="relative scroll-mt-[72px]">
  <div class:list={['relative mx-auto px-4 md:px-6 py-12 md:py-16 lg:py-20 text-default', width]}>
    <Headline title={heading ? esc(heading) : undefined} classes={{ container: 'max-w-none text-left mb-6 md:mb-8' }} />
    <slot />
  </div>
</section>
