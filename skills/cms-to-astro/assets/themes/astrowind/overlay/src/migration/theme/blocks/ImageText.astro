---
/**
 * image-text → AstroWind Content (text and image side by side, image cropped to 4:3).
 * Fields: heading?, text, image, alt?, imageSide?: left | right (default right), aspect?: 4/3 | 1/1 | 3/4.
 * Without an image it falls back to the text block.
 */
import Content from '~/components/widgets/Content.astro';
import Text from './Text.astro';
import { esc, richText } from '../aw';

interface Props {
  heading?: string;
  text?: string;
  image?: string;
  alt?: string;
  imageSide?: 'left' | 'right';
  aspect?: '4/3' | '1/1' | '3/4';
}

const { heading, text, image, alt = '', imageSide = 'right', aspect = '4/3' } = Astro.props;
---

{
  image ? (
    <Content
      title={heading ? esc(heading) : undefined}
      content={richText(text)}
      image={{ src: image, alt, aspect }}
      isReversed={imageSide === 'left'}
    />
  ) : (
    <Text heading={heading} text={text} />
  )
}
