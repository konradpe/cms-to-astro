---
/**
 * Site header in the theme's floating-pill style: logo, main menu from
 * src/data_files/navigation.ts (one level of submenus as Preline dropdowns:
 * hover on desktop, tap on phones), language links from the kit's page meta.
 * Below `lg` the menu collapses behind a toggle. The active item is marked on
 * the server (aria-current), no client script needed.
 */
import BrandLogo from '@components/BrandLogo.astro';
import MenuIcon from '@/assets/icons/menu.svg';
import CloseIcon from '@/assets/icons/close.svg';
import ChevronDownIcon from '@/assets/icons/chevron-down.svg';
import { navigationFor, type NavItem } from '@data/navigation';
import type { PageMeta } from '../../../migration/meta';
import { t } from '../../../migration/strings';
import { homeOf, keyOf } from '../../../migration/urls';
import { site } from '../../../migration/site.config';

interface Props {
  meta: PageMeta;
}

const { meta } = Astro.props;
const nav = navigationFor(meta.locale);
const here = meta.path ? keyOf(meta.path) : undefined;
const homes = new Set(site.locales.map((l) => keyOf(homeOf(l))));
const isCurrent = (item: NavItem) => here !== undefined && keyOf(item.href) === here;
// A menu item is active on its own page, its submenu pages and every page below them.
const isInSection = (item: NavItem) =>
  isCurrent(item) ||
  (here !== undefined &&
    [item.href, ...(item.children ?? []).map((c) => c.href)]
      .map(keyOf)
      .filter((k) => !homes.has(k))
      .some((k) => here === k || here.startsWith(`${k}/`)));
const languageName = (lang: string) => {
  const name = new Intl.DisplayNames([lang], { type: 'language' }).of(lang) ?? lang;
  return name.charAt(0).toUpperCase() + name.slice(1);
};

const ring = 'ring-zinc-500 outline-hidden focus-visible:ring-3';
const linkClass = `block rounded-lg px-3 py-2.5 text-base font-medium transition duration-300 lg:px-2.5 lg:py-3 lg:text-sm xl:px-3 ${ring}`;
const activeClass = 'text-neutral-900 underline decoration-orange-400 decoration-2 underline-offset-8';
const idleClass = 'text-neutral-600 hover:text-neutral-500';
const subLinkClass = `block rounded-lg px-3 py-3 text-sm lg:py-2 transition duration-300 ${ring}`;
---

<header class="sticky inset-x-0 top-4 z-50 flex w-full text-sm">
  <nav
    class="relative mx-2 flex w-full flex-wrap items-center justify-between gap-x-4 rounded-[36px] border border-yellow-100/40 bg-yellow-50/60 px-4 py-3 backdrop-blur-md lg:flex-nowrap lg:px-6 lg:py-0 xl:mx-auto"
    aria-label={nav.ui.mainNav}
  >
    <a class={`order-1 inline-flex min-h-11 flex-none items-center rounded-lg ${ring}`} href={homeOf(meta.locale)} aria-label={`${site.name}: ${nav.ui.home}`}>
      <BrandLogo class="h-8 w-auto" />
    </a>

    <div class="order-2 flex items-center gap-x-1 lg:order-3">
      {
        meta.languages.length > 1 && (
          <ul class="flex items-center gap-x-1" aria-label={t(meta.locale).languages}>
            {meta.languages.map((l) => (
              <li>
                <a
                  href={l.href}
                  hreflang={l.lang}
                  lang={l.lang}
                  title={languageName(l.lang)}
                  aria-current={l.current ? 'true' : undefined}
                  class:list={[
                    'inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-2 text-sm font-bold transition duration-300',
                    ring,
                    l.current ? 'bg-neutral-800 text-neutral-50' : 'text-neutral-600 hover:bg-neutral-200',
                  ]}
                >
                  {l.locale.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <button
        type="button"
        class={`hs-collapse-toggle inline-flex size-11 items-center justify-center rounded-full text-neutral-600 transition duration-300 hover:bg-neutral-200 lg:hidden ${ring}`}
        data-hs-collapse="#navbar-collapse"
        aria-controls="navbar-collapse"
        aria-expanded="false"
        aria-label={nav.ui.toggleMenu}
      >
        <MenuIcon class="hs-collapse-open:hidden size-5 shrink-0" aria-hidden="true" />
        <CloseIcon class="hs-collapse-open:block hidden size-5 shrink-0" aria-hidden="true" />
      </button>
    </div>

    <div
      id="navbar-collapse"
      class="hs-collapse order-3 hidden w-full basis-full overflow-hidden transition-[height] duration-300 lg:order-2 lg:block lg:w-auto lg:basis-auto lg:overflow-visible"
    >
      <ul class="mt-3 mb-2 flex flex-col gap-y-0.5 lg:my-0 lg:flex-row lg:items-center lg:gap-x-1">
        {
          nav.main.map((item) =>
            item.children?.length ? (
              <li class="hs-dropdown [--adaptive:none] [--strategy:static] lg:[--placement:bottom-left] lg:[--strategy:absolute] lg:[--trigger:hover]">
                <div class="hs-dropdown-toggle-wrapper flex items-center justify-between">
                  <a
                    href={item.href}
                    class:list={[linkClass, 'grow lg:pe-1', isInSection(item) ? activeClass : idleClass]}
                    aria-current={isCurrent(item) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class={`hs-dropdown-toggle relative rounded-lg p-3.5 text-neutral-600 transition duration-300 hover:text-neutral-500 lg:p-1.5 lg:before:absolute lg:before:-inset-2 ${ring}`}
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label={`${nav.ui.submenu}: ${item.label}`}
                  >
                    <ChevronDownIcon class="hs-dropdown-open:rotate-180 size-4 transition duration-300" aria-hidden="true" />
                  </button>
                </div>
                <div class="hs-dropdown-menu hs-dropdown-open:opacity-100 z-20 hidden opacity-0 transition-[opacity,margin] duration-150 before:absolute before:-top-3 before:start-0 before:h-3 before:w-full lg:w-72 lg:rounded-2xl lg:bg-neutral-50 lg:p-2 lg:shadow-2xl">
                  <ul class="ms-3 border-s border-neutral-300 ps-2 lg:ms-0 lg:border-0 lg:ps-0">
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          class:list={[subLinkClass, isCurrent(child) ? 'font-semibold text-neutral-900' : 'text-neutral-600 hover:bg-neutral-100 hover:text-neutral-800']}
                          aria-current={isCurrent(child) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class:list={[linkClass, isInSection(item) ? activeClass : idleClass]} aria-current={isCurrent(item) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </nav>
</header>
