---
/** hero: { heading, text?, image?, alt?, actions?: [{ label, href }] }. <h1> when it is the first block. */
import { markdown } from '../markdown';

interface Props {
  heading: string;
  text?: string;
  image?: string;
  alt?: string;
  actions?: { label: string; href: string }[];
  index?: number;
}

const { heading, text, image, alt = '', actions = [], index = 0 } = Astro.props;
const Heading = index === 0 ? 'h1' : 'h2';
---

<section class="kit-hero" class:list={[image && 'has-image']}>
  <div class="body">
    <Heading>{heading}</Heading>
    {text && <div set:html={markdown(text)} />}
    {
      actions.length > 0 && (
        <p class="actions">
          {actions.map((a) => (
            <a href={a.href}>{a.label}</a>
          ))}
        </p>
      )
    }
  </div>
  {image && <img src={image} alt={alt} />}
</section>

<style>
  .kit-hero {
    display: grid;
    gap: var(--kit-gap, 1.5rem);
    align-items: center;
    margin-block: 0 2.5rem;
  }
  @media (min-width: 48rem) {
    .kit-hero.has-image {
      grid-template-columns: 1fr 1fr;
    }
  }
  h1,
  h2 {
    margin: 0 0 0.5rem;
    line-height: 1.15;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }
  img {
    width: 100%;
    height: auto;
    border-radius: var(--kit-radius, 0.5rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .actions a {
    padding: 0.5rem 1rem;
    border: 1px solid currentColor;
    border-radius: var(--kit-radius, 0.5rem);
    text-decoration: none;
  }
</style>
