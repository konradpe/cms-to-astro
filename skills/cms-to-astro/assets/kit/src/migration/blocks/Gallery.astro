---
/**
 * gallery: { heading?, items: [{ src, alt?, caption?, full? }] }. Each image links to its large
 * version (`full`, else `src`); no lightbox script needed. A theme can swap in its lightbox.
 */
interface Item {
  src: string;
  alt?: string;
  caption?: string;
  full?: string;
}
interface Props {
  heading?: string;
  items?: Item[];
}

const { heading, items = [] } = Astro.props;
---

<section class="kit-gallery">
  {heading && <h2>{heading}</h2>}
  <ul>
    {
      items.map((item) => (
        <li>
          <figure>
            <a href={item.full ?? item.src}>
              <img src={item.src} alt={item.alt ?? ''} loading="lazy" decoding="async" />
            </a>
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .kit-gallery {
    margin-block: 0 2.5rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: calc(var(--kit-radius, 0.5rem) / 2);
  }
  figcaption {
    font-size: 0.875rem;
    color: var(--kit-muted, #5b6270);
  }
</style>
