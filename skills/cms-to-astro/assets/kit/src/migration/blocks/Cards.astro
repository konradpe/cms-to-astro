---
/** cards: { heading?, items: [{ title, text?, image?, alt?, href? }] }. A card with href is one link. */
import { markdown } from '../markdown';

interface Card {
  title: string;
  text?: string;
  image?: string;
  alt?: string;
  href?: string;
}
interface Props {
  heading?: string;
  items?: Card[];
}

const { heading, items = [] } = Astro.props;
---

<section class="kit-cards">
  {heading && <h2>{heading}</h2>}
  <ul>
    {
      items.map((card) => (
        <li>
          {card.image && <img src={card.image} alt={card.alt ?? ''} loading="lazy" decoding="async" />}
          <h3>{card.href ? <a href={card.href}>{card.title}</a> : card.title}</h3>
          {card.text && <div set:html={markdown(card.text)} />}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .kit-cards {
    margin-block: 0 2.5rem;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--kit-gap, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    position: relative;
    border: 1px solid var(--kit-line, #d9dce1);
    border-radius: var(--kit-radius, 0.5rem);
    padding: 1rem;
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: calc(var(--kit-radius, 0.5rem) / 2);
  }
  h3 {
    margin: 0.5rem 0;
  }
  /* The whole card is clickable through the heading link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
